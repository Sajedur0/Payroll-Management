<Window x:Class="PayrollManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payroll Management" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="assets/icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="0,25,0,0">
                <TextBlock Text="💼 Payroll Management" Foreground="White" FontSize="20"
                           FontWeight="Bold" Margin="20,0,0,35"/>

                <Button Content="🏠  Dashboard" Style="{StaticResource SidebarButton}"
                        Click="NavigateDashboard_Click"/>
                <Button Content="👥  Employee" Style="{StaticResource SidebarButton}"
                        Click="NavigateEmployee_Click"/>
                <Button Content="📋  Attendance Log" Style="{StaticResource SidebarButton}"
                        Click="NavigateAttendance_Click"/>
                <Button Content="📊  Report" Style="{StaticResource SidebarButton}"
                        Click="NavigateReport_Click"/>
                <Button Content="⚙️  Admin Tools" Style="{StaticResource SidebarButton}"
                        Click="NavigateAdmin_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="0"/>
    </Grid>
</Window>
