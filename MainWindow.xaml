<Window x:Class="PayrollManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payroll Management" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Icon="assets/icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="0,25,0,0">
                <TextBlock Text="💼 Payroll Management" Foreground="White" FontSize="20"
                           FontWeight="Bold" Margin="20,0,0,35"/>

                <!-- IsChecked=True হলে সিলেক্টেড স্টাইল (Background #4338CA + বামে indicator + SemiBold) দেখাবে -->
                <RadioButton x:Name="NavDashboard" Content="🏠  Dashboard" Style="{StaticResource SidebarRadioButton}"
                        GroupName="SidebarNav" IsChecked="True" Click="NavigateDashboard_Click"/>
                <RadioButton x:Name="NavEmployee" Content="👥  Employee" Style="{StaticResource SidebarRadioButton}"
                        GroupName="SidebarNav" Click="NavigateEmployee_Click"/>
                <RadioButton x:Name="NavAttendance" Content="📋  Attendance Log" Style="{StaticResource SidebarRadioButton}"
                        GroupName="SidebarNav" Click="NavigateAttendance_Click"/>
                <RadioButton x:Name="NavReport" Content="📊  Report" Style="{StaticResource SidebarRadioButton}"
                        GroupName="SidebarNav" Click="NavigateReport_Click"/>
                <RadioButton x:Name="NavAdmin" Content="⚙️  Admin Tools" Style="{StaticResource SidebarRadioButton}"
                        GroupName="SidebarNav" Click="NavigateAdmin_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="0"/>
    </Grid>
</Window>
