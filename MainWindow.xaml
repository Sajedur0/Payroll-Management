<Window x:Class="PayrollManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payroll Management — Enterprise HR &amp; Attendance"
        Height="780" Width="1320" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource AppFont}"
        Icon="assets/icon.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderThickness="0,0,0,1" BorderBrush="#1E293B">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" Background="#4F46E5" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#4F46E5"/>
                            </Border.Effect>
                            <TextBlock Text="💼" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Payroll Pro" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="HR &amp; Attendance Suite" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,14,0,14">
                    <StackPanel>
                        <TextBlock Text="MAIN NAVIGATION" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold"
                                   Margin="20,8,20,8" SnapsToDevicePixels="True"/>

                        <RadioButton x:Name="NavDashboard" Content="🏠   Dashboard"
                                     Style="{StaticResource SidebarRadioButton}"
                                     GroupName="SidebarNav" IsChecked="True" Click="NavigateDashboard_Click"/>

                        <RadioButton x:Name="NavEmployee" Content="👥   Employee Directory"
                                     Style="{StaticResource SidebarRadioButton}"
                                     GroupName="SidebarNav" Click="NavigateEmployee_Click"/>

                        <RadioButton x:Name="NavAttendance" Content="📋   Attendance Log"
                                     Style="{StaticResource SidebarRadioButton}"
                                     GroupName="SidebarNav" Click="NavigateAttendance_Click"/>

                        <RadioButton x:Name="NavReport" Content="📊   Reports &amp; PDF"
                                     Style="{StaticResource SidebarRadioButton}"
                                     GroupName="SidebarNav" Click="NavigateReport_Click"/>

                        <TextBlock Text="CONFIGURATION" Foreground="#64748B" FontSize="10.5" FontWeight="SemiBold"
                                   Margin="20,18,20,8" SnapsToDevicePixels="True"/>

                        <RadioButton x:Name="NavAdmin" Content="⚙️   Admin Tools"
                                     Style="{StaticResource SidebarRadioButton}"
                                     GroupName="SidebarNav" Click="NavigateAdmin_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Status Card -->
                <Border Grid.Row="2" Margin="14,12,14,16" Padding="14,12" Background="#1E293B" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Database Connected" Foreground="#F1F5F9" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="SQL Server Active • v2.5" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace (Column 1) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Workforce overview and daily attendance metrics" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Right Quick Status & Date Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅 " FontSize="12"/>
                                <TextBlock x:Name="CurrentDateText" Text="Current Date" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="20" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="System Online" FontSize="11.5" FontWeight="SemiBold" Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Container -->
            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="0"/>
        </Grid>
    </Grid>
</Window>
