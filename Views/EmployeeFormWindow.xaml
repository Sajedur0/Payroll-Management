<Window x:Class="PayrollManagement.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Profile Form" Height="740" Width="890"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Fill out employee identification, duty details, and compensation" FontSize="11.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6">
                    <TextBlock Text="{Binding FormModeSubtitle}" FontSize="11" Foreground="#A5B4FC" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Modal Error Banner -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFormError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FormErrorMessage}" Foreground="#991B1B" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Card 1: Basic & Identification -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="1. Basic &amp; Identity Information" FontSize="13.5" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- EmpID * -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="EmpID" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding EmpIDText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- Name * -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Full Name" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- Gender -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gender" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding GenderList}" SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- FatherName * -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Father's Name" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding FatherName, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- Religion -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Religion" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ReligionList}" SelectedItem="{Binding Religion, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Padding="8,6"/>
                            </StackPanel>

                            <!-- NID * -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="NID (National ID)" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding NID, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Job & Department -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="2. Department, Designation &amp; Duty Settings" FontSize="13.5" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- Designation * -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Designation" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- Section * -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Section" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- Department * -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Department" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding DepartmentList}" SelectedItem="{Binding Department, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Padding="8,6"/>
                            </StackPanel>

                            <!-- Shift -->
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Shift" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ShiftList}" SelectedItem="{Binding Shift, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Category -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Category" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding CategoryList}" SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Padding="8,6"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Status" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" IsEditable="False" Padding="8,6"/>
                            </StackPanel>

                            <!-- DOJ -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DOJ (Joining Date)" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding DOJDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,6" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Payroll & Address -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="3. Salary, Account &amp; Contact Address" FontSize="13.5" FontWeight="Bold" Foreground="#4F46E5" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- GrossWages * -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Gross Wages (Salary)" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding GrossWagesText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- RocketAC -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Rocket A/C (Account No)" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding RocketAC, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PresAddress -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Present Address" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding PresAddress, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>

                            <!-- PermAddress * -->
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Permanent Address" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" *" Foreground="#DC2626" FontSize="11.5"/>
                                </StackPanel>
                                <TextBox Text="{Binding PermAddress, UpdateSourceTrigger=PropertyChanged}" Padding="10,7"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="20,8" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Margin="0,0,12,0"/>
                <Button Content="{Binding SubmitButtonText}" Click="Submit_Click" Padding="26,8" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
