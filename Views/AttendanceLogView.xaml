<UserControl x:Class="DashboardApp.Views.AttendanceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" Margin="20,20,20,10" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Attendance Log" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="FACEIDDB → KQZ_Card → AttendanceDB • dbo.RawData" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Success Message -->
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="#059669" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSuccess}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="⟳ Reload" Command="{Binding LoadCommand}" Padding="16,8" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Filters + Attendance Data Load -->
        <Border Grid.Row="1" Background="White" Padding="15" Margin="20,0,20,10" CornerRadius="12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,5">
                    <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" VerticalAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="  (EmpID)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <Button Content="Search" Command="{Binding SearchCommand}" Padding="18,6" Background="#1E1B4B" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="5,0,0,5">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <!-- Attendance Data Load Button -->
                <Button Content="📥 Attendance Data Load" Command="{Binding LoadFromFaceIdCommand}" 
                        Padding="18,6" Background="#059669" Foreground="White" BorderThickness="0" 
                        Cursor="Hand" Margin="15,0,0,5" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <!-- Loading Indicators -->
                <TextBlock Text="Loading..." Foreground="#4F46E5" FontWeight="SemiBold" Margin="12,5,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- Progress Bar Card (Shows live count loaded & remaining) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Margin="20,0,20,10" Padding="16,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProgressVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ " FontSize="13" Foreground="#059669"/>
                        <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" FontSize="12.5" Foreground="#1F2937" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}" FontWeight="Bold" FontSize="13" Foreground="#059669" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Grid.Row="1" Height="10" Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                             Foreground="#059669" Background="#E5E7EB" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- DataGrid — RawData -->
        <Border Grid.Row="3" Background="White" CornerRadius="12" Margin="20,0,20,20" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding RawRecords}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" BorderThickness="0"
                      HeadersVisibility="Column" RowHeight="36" AlternatingRowBackground="#F9FAFB">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                    <DataGridTextColumn Header="EmpID" Binding="{Binding EmpID}" Width="120"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="120"/>
                    <DataGridTextColumn Header="In Time" Binding="{Binding InTimeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Out Time" Binding="{Binding OutTimeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Work Hours" Binding="{Binding WorkHoursDisplay}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

