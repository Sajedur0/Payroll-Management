<UserControl x:Class="DashboardApp.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="25" Background="{StaticResource BackgroundBrush}">
        <StackPanel>
            <!-- Header -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Report" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Report generated from AttendanceDB" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ReportDate}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Content="⟳ Refresh" Command="{Binding LoadCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,8" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Summary Cards from DB -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Employees" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Summary.TotalEmployees}" FontSize="22" FontWeight="Bold" Foreground="#4F46E5" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Present Today" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Summary.PresentToday}" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Absent Today" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Summary.AbsentToday}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="On Leave" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Summary.OnLeave}" FontSize="22" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Employee List for report -->
            <Border Background="White" CornerRadius="12" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Employee List (dbo.EmployeeInfo)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="400"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" BorderThickness="0" HeadersVisibility="Column" RowHeight="32" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="EmpID" Binding="{Binding EmpID}" Width="90"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="150"/>
                            <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="130"/>
                            <DataGridTextColumn Header="DOJ (Join Date)" Binding="{Binding DOJ}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

