<UserControl x:Class="PayrollManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer Padding="30" Background="{StaticResource BackgroundBrush}">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Welcome! See today's overall overview" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentDate}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Loading / Error Banner -->
            <Border Background="#FEF3C7" CornerRadius="8" Padding="12,8" Margin="0,0,0,15">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Summary Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#EEF2FF" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Employees" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4" FontSize="13"/>
                        <TextBlock Text="{Binding TotalEmployees}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="1" Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#ECFDF5" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Present Today" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4" FontSize="13"/>
                        <TextBlock Text="{Binding PresentToday}" FontSize="24" FontWeight="Bold" Foreground="#059669"/>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="2" Background="White" CornerRadius="14" Margin="0,0,10,0" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FEF2F2" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <TextBlock Text="❌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Absent Today" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4" FontSize="13"/>
                        <TextBlock Text="{Binding AbsentToday}" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

                <!-- Card 4 -->
                <Border Grid.Column="3" Background="White" CornerRadius="14" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Background="#FFFBEB" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left">
                            <TextBlock Text="🌴" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="On Leave" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,4" FontSize="13"/>
                        <TextBlock Text="{Binding OnLeave}" FontSize="24" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Chart Section -->
            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,20,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Weekly Attendance Trend" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Series="{Binding AttendanceSeries}"
                                        XAxes="{Binding WeekDaysAxis}"
                                        Height="260"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
